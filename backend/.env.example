ANTHROPIC_API_KEY=your_anthropic_api_key_here
JWT_SECRET=your-very-secure-jwt-secret-change-this
PORT=3001
FRONTEND_URL=http://localhost:5173

# PRIVACY NOTE:
# - Anthropic's API does NOT use your data for model training by default.
#   (This is separate from Claude.ai the consumer product.)
#   See: https://www.anthropic.com/policies/api-data-usage
# - This app also sends the "anthropic-training: deny" header on every request
#   to make the opt-out explicit at the API level.
# - All conversations, documents, and user data are stored ONLY on this server
#   in a local SQLite database. Nothing is sent to third parties beyond the
#   Anthropic API inference call itself.
